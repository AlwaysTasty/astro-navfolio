# Set these in Vercel (Project Settings > Environment Variables), never in the repo.
# Run `node scripts/spotify-auth.mjs` once to get the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# /files temp hosting (BLOB_READ_WRITE_TOKEN is added by Vercel when the Blob store is connected).
FILES_PASSPHRASE=
CRON_SECRET=
