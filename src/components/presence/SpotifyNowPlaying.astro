---
// Spinning record for my current or last-played Spotify track (from /api/spotify).
// "nav" sits in the top bar on wide screens; "dock" sits above the Discord ball on narrow ones.
interface Props {
  variant: 'nav' | 'dock';
}

const { variant } = Astro.props;
---

<div class="spotify-wrap" data-spotify-wrap data-variant={variant} hidden>
  <button
    class="spotify-disc"
    type="button"
    aria-label="Spotify: now playing"
    aria-expanded="false"
  >
    <span class="spotify-record" aria-hidden="true">
      <img data-spotify-art alt="" width="42" height="42" />
    </span>
  </button>
  <div class="spotify-box" role="status">
    <b data-spotify-label>Now playing</b>
    <span data-spotify-text></span>
  </div>
</div>

<script>
  interface Track {
    isPlaying: boolean;
    title: string;
    artist: string;
    art: string | null;
  }

  const POLL_MS = 30_000;
  // Undefined until the first reply. An error or empty reply hides the record.
  let track: Track | undefined;
  let timer = 0;

  const render = () => {
    for (const wrap of document.querySelectorAll<HTMLElement>('[data-spotify-wrap]')) {
      wrap.hidden = !track;
      if (!track) continue;
      const label = track.isPlaying ? 'Now playing' : 'Last played';
      wrap.dataset.playing = String(track.isPlaying);
      wrap.querySelector('[data-spotify-label]')!.textContent = label;
      wrap.querySelector('[data-spotify-text]')!.textContent = `${track.title} – ${track.artist}`;
      wrap.querySelector('button')!.setAttribute('aria-label', `Spotify: ${label.toLowerCase()}`);
      const art = wrap.querySelector<HTMLImageElement>('[data-spotify-art]')!;
      art.hidden = !track.art;
      if (track.art) art.src = track.art;
    }
  };

  const poll = async () => {
    try {
      const res = await fetch('/api/spotify');
      const data = res.ok ? await res.json() : {};
      track = data.title ? data : undefined;
    } catch {
      track = undefined;
    }
    render();
  };

  const schedule = () => {
    window.clearInterval(timer);
    if (document.hidden) return;
    void poll();
    timer = window.setInterval(poll, POLL_MS);
  };

  document.addEventListener('visibilitychange', schedule);
  // Click toggles the box (needed on touch); hover handles it with a mouse via CSS.
  document.addEventListener('click', (event) => {
    const hit = (event.target as Element).closest<HTMLElement>('[data-spotify-wrap]');
    for (const wrap of document.querySelectorAll<HTMLElement>('[data-spotify-wrap]')) {
      const open = wrap === hit && wrap.dataset.open !== 'true';
      wrap.dataset.open = String(open);
      wrap.querySelector('button')!.setAttribute('aria-expanded', String(open));
    }
  });
  // The header is re-created on each client-side navigation, so repaint from the last reply.
  document.addEventListener('astro:page-load', render);
  schedule();
</script>

<style is:global>
  .spotify-wrap {
    position: relative;
  }

  .blog-top-nav .nav-actions .spotify-wrap button.spotify-disc,
  .spotify-wrap button.spotify-disc {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.35));
  }

  /* The album art is the whole disc; the mask leaves the centre empty like a record's hole. */
  .spotify-record {
    position: relative;
    display: grid;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    overflow: hidden;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #0f0f10 0 1.2px, #232325 1.2px 2.4px);
    mask: radial-gradient(circle closest-side, transparent 0 19%, #000 20%);
    animation: spotify-spin 4s linear infinite;
  }

  .spotify-wrap[data-playing='false'] .spotify-record {
    animation-play-state: paused;
  }

  .spotify-record img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotify-record img[hidden] {
    display: none;
  }

  /* Light sheen so the spin reads even on flat artwork. */
  .spotify-record::after {
    grid-area: 1 / 1;
    background: conic-gradient(
      from 20deg,
      transparent 0 18%,
      rgba(255, 255, 255, 0.28) 25%,
      transparent 32% 68%,
      rgba(255, 255, 255, 0.2) 75%,
      transparent 82%
    );
    content: '';
  }

  .spotify-box {
    position: absolute;
    z-index: 5;
    display: block;
    width: max-content;
    max-width: min(280px, calc(100vw - 96px));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 9px 13px;
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    background: var(--paper-bg);
    box-shadow: var(--paper-shadow-lift);
    color: var(--paper-ink);
    font-size: 0.8rem;
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .spotify-box b {
    margin-right: 4px;
    color: var(--paper-ink-faint);
    font-weight: 700;
  }

  .spotify-wrap[data-open='true'] .spotify-box {
    opacity: 1;
  }

  @media (hover: hover) {
    .spotify-wrap:hover .spotify-box {
      opacity: 1;
    }
  }

  /* Top bar: box drops below the record, right-aligned to it. */
  .spotify-wrap[data-variant='nav'] .spotify-box {
    top: calc(100% + 14px);
    right: 0;
    transform: translateY(-4px);
  }

  .spotify-wrap[data-variant='nav'][data-open='true'] .spotify-box,
  .spotify-wrap[data-variant='nav']:hover .spotify-box {
    transform: translateY(0);
  }

  /* Narrow screens: record floats above the Discord ball, box opens to its right. */
  .spotify-wrap[data-variant='dock'] {
    position: fixed;
    bottom: 72px;
    left: 23px;
    z-index: 40;
  }

  .spotify-wrap[data-variant='dock'] .spotify-record {
    width: 50px;
    height: 50px;
  }

  .spotify-wrap[data-variant='dock'] .spotify-box {
    bottom: 0;
    white-space: normal;
    left: calc(100% + 8px);
  }

  .spotify-wrap[data-variant='nav']:not([hidden]) {
    display: none;
  }

  @media (min-width: 960px) {
    .spotify-wrap[data-variant='nav']:not([hidden]) {
      display: block;
    }

    .spotify-wrap[data-variant='dock'] {
      display: none;
    }
  }

  @keyframes spotify-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotify-record {
      animation: none;
    }
  }
</style>
