---
// Floating Discord ball (bottom left). Hover, focus or tap shows status and rich presence.
import SpotifyNowPlaying from './SpotifyNowPlaying.astro';
---

<SpotifyNowPlaying variant="dock" />

<div class="presence-dock" data-presence-dock hidden>
  <button
    class="presence-ball"
    type="button"
    aria-label="Discord status"
    aria-describedby="discord-card"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
      <path
        d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
      ></path>
    </svg>
    <span class="presence-dot" data-presence-dot></span>
  </button>
  <div class="presence-card" id="discord-card" role="status">
    <strong data-presence-title>Discord</strong>
    <span data-presence-detail></span>
  </div>
</div>

<script>
  import { getPresence, onPresence, type LanyardActivity, type LanyardData } from './lanyard';

  const STATUS = {
    online: 'Online',
    idle: 'Idle',
    dnd: 'Do not disturb',
    offline: 'Offline',
  } as const;
  const VERB: Record<number, string> = {
    0: 'Playing',
    1: 'Streaming',
    3: 'Watching',
    5: 'Competing in',
  };

  // Custom status (4) and Spotify (2) are left out: Spotify has its own navbar pill.
  const describe = (activity: LanyardActivity) =>
    [`${VERB[activity.type]} ${activity.name}`, activity.details, activity.state]
      .filter(Boolean)
      .join(' · ');

  const render = (data: LanyardData | null | undefined) => {
    for (const dock of document.querySelectorAll<HTMLElement>('[data-presence-dock]')) {
      dock.hidden = !data;
      if (!data) continue;
      const activity = data.activities.find((a) => a.type in VERB);
      dock.dataset.status = data.discord_status;
      dock.querySelector('[data-presence-title]')!.textContent =
        `Discord · ${STATUS[data.discord_status]}`;
      dock.querySelector('[data-presence-detail]')!.textContent = activity
        ? describe(activity)
        : '';
    }
  };

  const bindTap = () => {
    for (const dock of document.querySelectorAll<HTMLElement>('[data-presence-dock]')) {
      const ball = dock.querySelector('button')!;
      if (ball.dataset.ready) continue;
      ball.dataset.ready = 'true';
      ball.addEventListener('click', () => {
        const open = dock.dataset.open !== 'true';
        dock.dataset.open = String(open);
        ball.setAttribute('aria-expanded', String(open));
      });
    }
    document.addEventListener('click', (event) => {
      for (const dock of document.querySelectorAll<HTMLElement>('[data-presence-dock]')) {
        if (!dock.contains(event.target as Node)) dock.dataset.open = 'false';
      }
    });
  };

  onPresence(render);
  document.addEventListener('astro:page-load', () => {
    bindTap();
    render(getPresence());
  });
  bindTap();
</script>

<style>
  .presence-dock {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 40;
  }

  .presence-dock[hidden] {
    display: none;
  }

  .presence-ball {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--paper-line);
    border-radius: 50%;
    background: var(--paper-nav);
    box-shadow: var(--paper-shadow);
    color: var(--paper-ink);
    cursor: pointer;
  }

  .presence-ball:hover,
  .presence-ball:focus-visible {
    color: var(--paper-accent);
  }

  .presence-dot {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 11px;
    height: 11px;
    border: 2px solid var(--paper-surface);
    border-radius: 50%;
    background: #747f8d;
  }

  .presence-dock[data-status='online'] .presence-dot {
    background: #3ba55d;
  }

  .presence-dock[data-status='idle'] .presence-dot {
    background: #faa81a;
  }

  .presence-dock[data-status='dnd'] .presence-dot {
    background: #ed4245;
  }

  .presence-card {
    position: absolute;
    bottom: 0;
    left: calc(100% + 10px);
    display: grid;
    gap: 2px;
    width: max-content;
    max-width: min(280px, calc(100vw - 96px));
    padding: 10px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-nav);
    box-shadow: var(--paper-shadow);
    color: var(--paper-ink-soft);
    font-size: 0.8rem;
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .presence-card strong {
    color: var(--paper-ink);
    font-size: 0.82rem;
  }

  .presence-card span:empty {
    display: none;
  }

  .presence-dock:hover .presence-card,
  .presence-dock:focus-within .presence-card,
  .presence-dock[data-open='true'] .presence-card {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .presence-card {
      transition: none;
    }
  }
</style>
